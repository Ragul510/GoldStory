# Your real public site URL (canonical links, social previews)
VITE_SITE_URL=https://yourdomain.com
# Leave empty to use the same origin (recommended). Only set if the API is on another domain (then enable CORS in the API).
VITE_API_URL=
# true = show built-in dummy products when the API is down. Use false in production.
VITE_DEMO_FALLBACK=false
